<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jobtracker.ui.HomeController">
   <left>
      <VBox alignment="TOP_CENTER" prefHeight="600.0" prefWidth="150.0" BorderPane.alignment="CENTER">
         <children>
            <AnchorPane prefHeight="145.0" prefWidth="150.0" />
            <Button alignment="CENTER" mnemonicParsing="false" onAction="#homeBtn" prefHeight="40.0" prefWidth="100.0" text="Home" textAlignment="CENTER">
               <font>
                  <Font name="MuktaMahee SemiBold" size="13.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </VBox.margin>
            </Button>
            <Button alignment="CENTER" mnemonicParsing="false" onAction="#applicationBtn" prefHeight="40.0" prefWidth="100.0" text="Applications" textAlignment="CENTER">
               <font>
                  <Font name="MuktaMahee SemiBold" size="13.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </VBox.margin>
            </Button>
            <Button alignment="CENTER" mnemonicParsing="false" onAction="#urgentBtn" prefHeight="40.0" prefWidth="100.0" text="Urgents" textAlignment="CENTER">
               <font>
                  <Font name="MuktaMahee SemiBold" size="13.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </VBox.margin>
            </Button>
            <Button alignment="CENTER" mnemonicParsing="false" onAction="#finishedBtn" prefHeight="40.0" prefWidth="100.0" text="Finished" textAlignment="CENTER">
               <font>
                  <Font name="MuktaMahee SemiBold" size="13.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </VBox.margin>
            </Button>
            <AnchorPane prefHeight="100.0" prefWidth="150.0" />
            <Button alignment="CENTER" layoutX="35.0" layoutY="410.0" mnemonicParsing="false" onAction="#exitBtn" prefHeight="40.0" prefWidth="100.0" text="Exit" textAlignment="CENTER">
               <font>
                  <Font name="MuktaMahee SemiBold" size="13.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </VBox.margin>
            </Button>
         </children>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
      </VBox>
   </left>
   <center>
      <SplitPane dividerPositions="0.65" prefHeight="600.0" prefWidth="900.0" BorderPane.alignment="CENTER">
         <items>
            <ScrollPane prefHeight="450.0" prefWidth="473.0">
               <content>
                  <VBox fx:id="applicationList" prefHeight="600.0" prefWidth="900.0" />
               </content>
            </ScrollPane>
            <VBox fx:id="detailPanel" prefHeight="527.0" prefWidth="258.0" />
         </items>
      </SplitPane>
   </center>
   <bottom>
      <HBox fx:id="operation" alignment="CENTER" prefHeight="50.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <children>
            <Button alignment="CENTER" mnemonicParsing="false" onAction="#createBtn" prefHeight="40.0" prefWidth="100.0" text="Create">
               <HBox.margin>
                  <Insets />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
   </bottom>
</BorderPane>
